{
  "name": "mipstream",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "engine:check": "vite build --config vite.engine-check.config.ts && node .engine-check/engine-smoke.js",
    "assembler:check": "vite build --config vite.assembler-check.config.ts && node .assembler-check/assembler-smoke.js",
    "language:check": "vite build --config vite.language-check.config.ts && node .language-check/language-smoke.js",
    "simulation:check": "vite build --config vite.simulation-check.config.ts && node .simulation-check/simulation-smoke.js",
    "check": "npm run engine:check && npm run assembler:check && npm run language:check && npm run simulation:check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tabler/icons-vue": "^3.48.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "golden-layout": "^2.6.0",
    "jsstore": "^4.9.0",
    "konva": "^10.7.0",
    "naive-ui": "^2.45.3",
    "path": "^0.12.7",
    "pinia": "^3.0.1",
    "postcss": "^8.5.28",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "3",
    "vue-draggable-plus": "^0.6.1",
    "vue-konva": "^4.0.1",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass-embedded": "^1.83.4",
    "sass-migrator": "^2.2.1",
    "typescript": "^5.0.2",
    "unplugin-vue-markdown": "^28.3.1",
    "vite": "^6.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "vue-tsc": "^2.2.8"
  }
}
